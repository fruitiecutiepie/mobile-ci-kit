#!/bin/sh
# gha_prepare_emulator_runner -- make a GitHub-hosted Linux runner able to boot an Android emulator.
#
# Two prerequisites, each of which fails in a way that points somewhere else.
#
# 1. KVM ACCESS. Hardware-accelerated virtualisation IS available on standard 2-vCPU GitHub-hosted
#    Linux runners, but the runner user cannot open /dev/kvm until a udev rule grants it. Without
#    that, the emulator silently falls back to software rendering and effectively never finishes
#    booting. The symptom is the boot timeout expiring, which reads like a broken AVD or a bad system
#    image rather than a permissions problem.
#
# 2. DISK HEADROOM. A runner has only a few GB free once the SDK, a system image and caches are in
#    place. The emulator needs a multi-GB userdata partition, and without one it dies INSTANTLY with
#    "Not enough space to create userdata partition" -- after which the emulator action burns its
#    entire boot timeout polling for a device that will never appear. A 45-minute job then spends 45
#    minutes failing for a reason it printed in the first second.
#
#    The reclaim list deliberately does NOT touch the Android SDK or the JDK. `df` is printed before
#    and after on purpose: when this stops being enough, you want the number in the log, not a rerun.
#
# This lives in a script rather than in each action's YAML so both emulator lanes share ONE copy of
# the tuning. Two composite actions with their own copies drift, and the drift is invisible until one
# lane starts failing for a reason the other already fixed.
#
# Requires sudo (GitHub-hosted runners have it). Safe to run more than once.
#
# Part of mobile-ci-kit. MIT licensed -- copy this file into your own repo freely.
set -eu

label='gha-prepare-emulator-runner'

note() {
  printf '%s: %s\n' "$label" "$1"
}

if [ "$#" -ne 0 ]; then
  printf '%s\n' 'Usage: gha_prepare_emulator_runner' >&2
  exit 2
fi

if [ "$(uname -s)" != 'Linux' ]; then
  note "not Linux ($(uname -s)); nothing to do."
  exit 0
fi

note 'granting the runner user access to /dev/kvm'
printf '%s\n' 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' \
  | sudo tee /etc/udev/rules.d/99-kvm4all.rules >/dev/null
sudo udevadm control --reload-rules
sudo udevadm trigger --name-match=kvm

# `udevadm trigger` is ASYNCHRONOUS -- it queues events and returns. `settle` waits for the queue to
# drain, and without it the permissions are simply not applied yet when the next command runs.
#
# This is not a hypothetical. An earlier version of this script checked `/dev/kvm` immediately after
# the trigger and turned a WORKING lane red: on one commit, the same script on the same runner image
# reported "readable and writable" in one job and "still not read-write" in another, purely because
# the first job happened to run `setup-java` beforehand and the second did not. Same code, opposite
# results -- which is what proved it was a race rather than a real KVM problem.
sudo udevadm settle --timeout=30 || note 'udevadm settle timed out; continuing'

# The check is ADVISORY, deliberately, and this is the interesting part.
#
# Its value is diagnostic: when the emulator later dies on a boot timeout, this line in the log is
# the answer. But it must not be a gate, because the empirical evidence is that the emulator boots
# successfully even in runs where this check was unhappy -- so making it fatal converts a useful hint
# into a false negative that blocks a working lane. A guard that fires when nothing is wrong gets
# deleted, and takes its diagnostic value with it.
kvm_state='unknown'
i=0
while [ "$i" -lt 10 ]; do
  if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
    kvm_state='ok'
    break
  fi
  i=$((i + 1))
  sleep 1
done

if [ "$kvm_state" = 'ok' ]; then
  note '/dev/kvm is readable and writable'
else
  note 'WARNING: /dev/kvm is not read-write after applying the udev rule and settling.'
  note 'The emulator may fall back to software rendering and never finish booting. If a boot'
  note 'timeout follows, this is the first thing to read. Continuing anyway: this has been observed'
  note 'to be a false alarm, and refusing to continue would block a lane that does in fact work.'
  # `ls -l` on one fixed path, purely to print mode and ownership for a human reading the log.
  # SC2012's concern is parsing ls output for filenames; nothing here parses anything.
  # shellcheck disable=SC2012
  ls -l /dev/kvm 2>&1 | sed "s/^/$label:   /" || true
fi

note 'reclaiming disk before the emulator boots'
printf 'Before: '
df -h /home/runner | tail -n 1
sudo rm -rf \
  /usr/share/dotnet \
  /usr/share/swift \
  /usr/local/share/powershell \
  /usr/local/lib/heroku \
  /opt/ghc \
  /opt/hostedtoolcache/CodeQL \
  /opt/google/chrome
printf 'After:  '
df -h /home/runner | tail -n 1
